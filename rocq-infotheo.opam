# This file was generated from `meta.yml`, please do not edit manually.
# Follow the instructions on https://github.com/coq-community/templates to regenerate.

opam-version: "2.0"
maintainer: "Anonymous"
version: "dev"

homepage: "https://github.com/affeldt-aist/infotheo"
dev-repo: "git+https://github.com/affeldt-aist/infotheo.git"
bug-reports: "https://github.com/affeldt-aist/infotheo/issues"
license: "LGPL-2.1-or-later"

synopsis: "Discrete probabilities and information theory for Rocq"
description: """
Infotheo is a Rocq library for reasoning about discrete probabilities,
information theory, and linear error-correcting codes."""

build: [
  [make "-j%{jobs}%" ]
  [make "-C" "extraction" "tests"] {with-test}
]
install: [make "install"]
depends: [
  "coq" { = "9.0.0" }
  "coq-mathcomp-ssreflect" { = "2.5.0" }
  "coq-mathcomp-fingroup" { = "2.5.0" }
  "coq-mathcomp-algebra" { = "2.5.0" }
  "coq-mathcomp-solvable" { = "2.5.0" }
  "coq-mathcomp-field" { = "2.5.0" }
  "coq-mathcomp-analysis" { = "1.15.0" }
  "coq-mathcomp-reals-stdlib" { = "1.15.0" }
  "coq-hierarchy-builder" { = "1.10.1" }
  "rocq-elpi" { = "3.2.0" }
  "coq-mathcomp-algebra-tactics" { = "1.2.7" }
  "coq-interval" { = "4.11.3" }
  "rocq-robot-rocq" { = "0.3.1" }
]

tags: [
  "keyword:information theory"
  "keyword:probability"
  "keyword:error-correcting codes"
  "keyword:convexity"
  "logpath:infotheo"
]
authors: [
  "Anonymous"
]
