// PGG wreath: how the certificate, characterization records, and piSMC program
// connect. Render: dot -Tpng pgg_relation_diagram.dot -o pgg_relation_diagram.png
digraph pgg_relations {
  rankdir=LR;
  nodesep=0.35; ranksep=0.7;
  fontname="Helvetica"; fontsize=15; labelloc=t;
  label="PGG wreath: certificate  ->  characterization records  ->  piSMC program";
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled",
        fillcolor=white, margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333"];

  // ---- CERTIFICATE (external) -------------------------------------------
  subgraph cluster_cert {
    label="CERTIFICATE (external, Python)"; labeljust=l;
    style="rounded,filled"; fillcolor="#fff3e6"; color="#cc8800"; fontcolor="#995500";
    cert  [label="wreath_spectral_certificate.py (+ .md)\nexact-rational LDL^T of\nalpha^2 I - Q^2  (13 pivots > 0)",
           shape=note, fillcolor="#ffe6cc"];
    axiom [label="wreath_rayleigh_Qsq_R   (Axiom)\n<v, Q^2 v>  <=  alpha^2 <v,v>\nalpha = 17/20", style="filled,dashed", fillcolor="#ffe0e0"];
  }

  // ---- CHARACTERIZATION RECORDS -----------------------------------------
  subgraph cluster_rec {
    label="CHARACTERIZATION RECORDS"; labeljust=l;
    style="rounded,filled"; fillcolor="#eef4ff"; color="#3366aa"; fontcolor="#234a80";
    symm     [label="wreath_schreier_symm\nQ symmetric via\ninverse-closed generators"];
    conv     [label="wreath_spectral_convergence_gap\nvar_dist <= sqrt(14) * (1-gap)^L"];
    schreier [label="wreath_schreier_certificate\n: SchreierCertificate", fillcolor="#d6e8ff"];
    asym     [label="wreath_asymptotic\n: SecurityAsymptotic\n(sa_eps_inf = 0)", fillcolor="#d6e8ff"];
    secw     [label="wreath_security_witness_asymptotic\n: SecurityWitness", fillcolor="#bcd8ff"];
    scheme   [label="wreath2_scheme\n: ThresholdScheme\n(T = 14, k = 7)", fillcolor="#d6e8ff"];
    pin      [label="wreath_sym_PI\n: PGGInterface", fillcolor="#d6e8ff"];
    cover    [label="wreath_covering_sym\n: CoveringScheme\n(genus 4)", fillcolor="#d6e8ff"];
    crig     [label="wreath_rigidity_cryptographically_secure\n: CombinatorialRigidity", fillcolor="#e7d6ff"];
  }

  // ---- piSMC PROGRAM ----------------------------------------------------
  subgraph cluster_prog {
    label="piSMC PROGRAM (one shared run_*)"; labeljust=l;
    style="rounded,filled"; fillcolor="#eafaea"; color="#338833"; fontcolor="#205020";
    profile [label="wreath_profile\n: MonodromyProfile", fillcolor="#c7eac7"];
    program [label="run_dealer / run_party / run_verifier\n= exchange_* (piSMC) at mp_PI", fillcolor="#d8f5d8"];
    chars   [label="characters\nrun_eps, run_k,\nrun_anonymous, run_private, run_recovers", fillcolor="#d8f5d8"];
    plugs   [label="sibling plugs into the SAME program:\nabel_profile  (security floors, k=2)\ns5_profile  (vanishes, k=5)",
             shape=note, fillcolor="#f2f2f2", fontcolor="#555555"];
  }

  // ---- spectral chain (certificate -> records) --------------------------
  cert     -> axiom    [label="certifies (external)"];
  axiom    -> conv     [label="Rayleigh bound feeds\nsymm_ds_TV_bound_cV"];
  symm     -> conv     [label="supplies Q_symm"];
  conv     -> schreier [label="sc_convergence"];
  schreier -> asym     [label="security_witness_\nschreier_asymptotic"];
  asym     -> secw     [label="Some  ->  sw_asymptotic"];

  // ---- records -> rigidity ----------------------------------------------
  secw  -> crig [label="cr_security"];
  cover -> crig [label="cr_covering"];

  // ---- records -> piSMC program -----------------------------------------
  secw    -> profile [label="mp_security"];
  scheme  -> profile [label="mp_scheme"];
  pin     -> profile [label="mp_PI"];
  profile -> program [label="run_profile"];
  program -> chars   [label="exposes"];
  profile -> plugs   [style=dotted, dir=none, label="one of 3 plugs", constraint=false];

  // ---- which record drives which character ------------------------------
  secw   -> chars [label="sw_bound_eps -> run_eps\nsw_bound -> run_anonymous",
                   style=dashed, color="#3366aa", fontcolor="#3366aa", constraint=false];
  scheme -> chars [label="ts_k -> run_k\nts_private -> run_private\nts_correct -> run_recovers",
                   style=dashed, color="#3366aa", fontcolor="#3366aa", constraint=false];
}
