                          "type": "text",
                          "id": "rbRb3",
                          "fill": "#0E2747",
                          "content": "T ≤ k + 2g",
                          "fontFamily": "Inter",
                          "fontSize": 30,
                          "fontWeight": "800",
                          "letterSpacing": -0.5
                        },
                        {
                          "type": "text",
                          "id": "ytBhm",
                          "fill": "#3B9B6D",
                          "content": "g = 0   ⇒   T ≤ k     (no overhead, no leaked shares)",
                          "fontFamily": "Inter",
