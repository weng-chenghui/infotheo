              "textGrowth": "fixed-width",
              "width": 1400,
              "content": "Eight rules drafted from one nineteen-day pair-formalization sprint with AI. Each rule was learned the painful way, and each names a pitfall we now try to avoid on every new file.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 30,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "d8d2Vw",
      "x": 3919,
      "y": 7408,
      "name": "Slide 5c-i-pre - Threshold privacy landscape",
      "clip": true,
      "width": 1920,
      "height": 1080,
      "fill": "#F6F1E7",
      "layout": "vertical",
      "gap": 24,
      "padding": [
        60,
        120
      ],
      "children": [
        {
          "type": "text",
          "id": "B0qXu",
          "name": "eyebrow",
          "fill": "#E8573F",
          "content": "02 / PROTOTYPING RESULTS",
          "fontFamily": "Inter",
          "fontSize": 22,
          "fontWeight": "700",
          "letterSpacing": 3
        },
        {
          "type": "text",
          "id": "SZ6rG",
          "name": "title",
          "fill": "#0E2747",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The (k, T)-threshold landscape",
          "lineHeight": 1.05,
          "fontFamily": "Inter",
          "fontSize": 60,
          "fontWeight": "800",
          "letterSpacing": -2
        },
        {
          "type": "text",
          "id": "mqHJg",
          "name": "subtitle",
          "fill": "#5B6680",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A secret split into many shares. Privacy below k (no leakage), recovery at T (the secret comes back). Different constructions price the gap T - k differently.",
          "lineHeight": 1.35,
          "fontFamily": "Inter",
          "fontSize": 22,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "DaEKw",
          "name": "contentRow",
          "width": "fill_container",
          "height": "fill_container",
          "gap": 36,
          "children": [
            {
              "type": "frame",
              "id": "oLqVx",
              "name": "lhsColumn",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "gap": 14,
              "padding": [
                6,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "caoCk",
                  "name": "lhsHead",
                  "fill": "#0E2747",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Why threshold privacy?",
                  "fontFamily": "Inter",
                  "fontSize": 26,
                  "fontWeight": "800",
                  "letterSpacing": -0.5
                },
                {
                  "type": "frame",
                  "id": "HCuHd",
                  "name": "b1",
                  "width": "fill_container",
                  "fill": "#0E274708",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    10,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "uZFJp",
                      "name": "b1m",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Distributed trust.",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "BU9IN",
                      "name": "b1s",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A secret is split into shares so no single party holds it. The protocol distributes trust by handing out one share per party.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "QRd1h",
                  "name": "b2",
                  "width": "fill_container",
                  "fill": "#0E274708",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    10,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "EudK3",
                      "name": "b2m",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The (k, T)-threshold.",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "LcHsB",
                      "name": "b2s",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "k = privacy threshold (any coalition of <= k shares is jointly uniform, nothing leaks). T = recovery threshold (any coalition of >= T shares reconstructs the secret). The gap T - k is the cost dial: gap = 1 means tight recovery; gap = 2g means the scheme carries 2g secret pieces, paid for by 2g extra shares.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Xf05o",
                  "name": "b4",
                  "width": "fill_container",
                  "fill": "#3B9B6D12",
                  "cornerRadius": 10,
                  "stroke": {
                    "align": "inside",
                    "thickness": 1.2,
                    "fill": "#3B9B6D40"
                  },
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    10,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "QjjDo",
                      "name": "b4m",
                      "fill": "#3B9B6D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Algebraic geometry codes: curves realizing groups.",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "CUCCo",
                      "name": "b4s",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Positive-genus AG codes pay genus for a smaller alphabet and matched-curve symmetry. The deck group must act as automorphisms of the underlying curve. Bring's curve (g = 4) realises S_5 with gap = 2g = 8; this is the s5 instance of the framework.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "vKHpL",
                  "name": "b5",
                  "width": "fill_container",
                  "fill": "#0E274710",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    10,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "zE9dk",
                      "name": "b5m",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "S5 x S5 sits at the cliff edge.",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "nHIZ6",
                      "name": "b5s",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Classical schemes (sum-mod, Shamir, packed Shamir) work fine. AG-on-a-curve does not: the smallest connected curve carrying S5 x S5 as deck group has g = 15,121, gap = 30,242 cards. Surface AG codes (Couvreur and co-authors) are the research direction.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "pUz4z",
              "name": "rhsColumn",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FAFAF6",
              "cornerRadius": 16,
              "stroke": {
                "align": "inside",
                "thickness": 2,
                "fill": "#E1DBCE"
              },
              "layout": "vertical",
              "gap": 10,
              "padding": [
                18,
                20
              ],
              "children": [
                {
                  "type": "text",
                  "id": "C6Ko9D",
                  "name": "rhsHead",
                  "fill": "#0E2747",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Comparison",
                  "fontFamily": "Inter",
                  "fontSize": 22,
                  "fontWeight": "800",
                  "letterSpacing": -0.5
                },
                {
                  "type": "frame",
                  "id": "NVqKX",
