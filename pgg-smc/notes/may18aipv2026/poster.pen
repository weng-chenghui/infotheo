                      "fontSize": 16,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "xrw1j",
                      "name": "realB",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Riemann-Hurwitz constrains nat-arithmetic tuples (g, R, |G|) but does not produce a curve. Many Hurwitz-valid tuples have no realising curve at all. Every instance must commit to a named algebraic-geometry object: P¹ for C₅, Bring's curve for S₅, an inverse-Galois construction for S₅×S₅. The framework records this via realised_by_curve, distinguishing arithmetic feasibility from geometric existence.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "z4y7u",
                  "name": "chainBox",
                  "width": "fill_container",
                  "fill": "#0E274710",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "gap": 4,
                  "padding": [
                    12,
                    20
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "QzsyO",
                      "name": "chainT",
                      "fill": "#0E2747",
                      "content": "|G| → forced regime → genus floor → gap ceiling",
                      "fontFamily": "Inter",
                      "fontSize": 18,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "R2ZAGz",
                      "name": "chainA",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Klein and Hurwitz together turn a single Riemann-Hurwitz equation into three asymmetric regimes; the slide title's tradeoff is really a piecewise landscape.",
                      "lineHeight": 1.4,
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "SVvBb",
      "x": 6039,
      "y": 7408,
      "name": "Slide 5c-i - Groups in the language of curves",
      "clip": true,
      "width": 1920,
      "height": 1080,
      "fill": "#F6F1E7",
      "layout": "vertical",
      "gap": 32,
      "padding": [
        60,
        120
      ],
      "children": [
        {
          "type": "text",
          "id": "XIkyh",
          "name": "eyebrow",
          "fill": "#E8573F",
          "content": "02 / PROTOTYPING RESULTS",
          "fontFamily": "Inter",
          "fontSize": 22,
          "fontWeight": "700",
          "letterSpacing": 3
        },
        {
          "type": "text",
          "id": "mv13Q",
          "name": "title",
          "fill": "#0E2747",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Groups in the language of curves",
          "lineHeight": 1.05,
          "fontFamily": "Inter",
          "fontSize": 64,
          "fontWeight": "800",
          "letterSpacing": -2
        },
        {
          "type": "text",
          "id": "BR1cD",
          "name": "sub",
          "fill": "#5B6680",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A group with relations and a curve with automorphisms are the same data in two languages.\nBring's curve makes this explicit for S_5.",
          "lineHeight": 1.35,
          "fontFamily": "Inter",
          "fontSize": 28,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "eBWVV",
          "name": "contentRow",
          "width": "fill_container",
          "height": "fill_container",
          "gap": 48,
          "children": [
            {
              "type": "frame",
              "id": "QWRWN",
              "name": "bullets",
              "width": 939,
              "height": "fill_container",
              "layout": "vertical",
              "gap": 24,
              "padding": [
                20,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "OJRa4",
                  "name": "b1",
                  "width": "fill_container",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "LVKyn",
                      "name": "d1",
                      "fill": "#E8573F",
                      "content": "—",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "h8zz7D",
                      "name": "b1c",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "qWhUA",
                          "name": "b1m",
                          "fill": "#0E2747",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A group is a presentation: generators and relations.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "LVZoe",
                          "name": "b1s",
                          "fill": "#9B9484",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "→ S₅ is generated by σ = (1 2 3 4 5) and τ = (1 2), with the Coxeter A₄ relations σ⁵ = τ² = (στ)⁴ = e.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "500",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ThCBM",
                  "name": "b2",
                  "width": "fill_container",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "w6brF",
                      "name": "d2",
                      "fill": "#E8573F",
                      "content": "—",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "CCWDM",
                      "name": "b2c",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "VALyu",
                          "name": "b2m",
                          "fill": "#0E2747",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "A curve is polynomial equations in projective space.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "S9yoV",
                          "name": "b2s",
                          "fill": "#9B9484",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "→ Bring's curve sits in P⁴ as the simultaneous zero locus of three symmetric equations Σ xᵢ = 0, Σ xᵢ² = 0, Σ xᵢ³ = 0.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "500",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "t9XlZ",
                  "name": "b3",
                  "width": "fill_container",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "s0Kys",
                      "name": "d3",
                      "fill": "#E8573F",
                      "content": "—",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "q89Afs",
                      "name": "b3c",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "jfY9X",
                          "name": "b3m",
                          "fill": "#0E2747",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The group acts on the curve by automorphisms.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "Rvicw",
                          "name": "b3s",
                          "fill": "#9B9484",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "→ S₅ permutes the five coordinates, σ·(x₁,…,x₅) = (x_{σ(1)},…,x_{σ(5)}). Each group element becomes a self-map of the curve.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "500",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fd5dH",
                  "name": "b4",
                  "width": "fill_container",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "g8knjM",
                      "name": "d4",
                      "fill": "#E8573F",
                      "content": "—",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "X8ZyGc",
                      "name": "b4c",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "EWAvi",
                          "name": "b4m",
                          "fill": "#0E2747",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Invariance ties the two languages together.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "y2TcmT",
                          "name": "b4s",
                          "fill": "#9B9484",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "→ The three defining polynomials are symmetric in x₁,…,x₅, so reordering the variables leaves them unchanged. The curve maps to itself, and the relations of S₅ become composition rules of automorphisms.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "500",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "XVTI7",
                  "name": "b5",
                  "width": "fill_container",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "McRws",
                      "name": "d5",
                      "fill": "#E8573F",
                      "content": "—",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    },
                    {
                      "type": "frame",
                      "id": "J1RwjJ",
                      "name": "b5c",
                      "width": "fill_container",
                      "layout": "vertical",
                      "gap": 6,
                      "children": [
                        {
                          "type": "text",
                          "id": "ND3Ly",
                          "name": "b5m",
                          "fill": "#0E2747",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The curve is the geometric carrier of the group.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 28,
                          "fontWeight": "500"
                        },
                        {
                          "type": "text",
                          "id": "pWb2s",
                          "name": "b5s",
                          "fill": "#9B9484",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "→ Generators and relations on one side, automorphisms and invariant polynomials on the other. Riemann-Hurwitz, the Hurwitz automorphism bound, and the PGL bound filter which curves can carry a given G.",
                          "lineHeight": 1.4,
                          "fontFamily": "Inter",
                          "fontSize": 22,
                          "fontWeight": "500",
                          "fontStyle": "italic"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "EhdJR",
              "name": "bridgeVisual",
