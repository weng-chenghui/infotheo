                  "children": [
                    {
                      "type": "text",
                      "id": "EGWW8",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "LESSONS LEARNED",
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "700",
                      "letterSpacing": 2.5
                    },
                    {
                      "type": "text",
                      "id": "W8YLD",
                      "name": "lesson1head",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Verifying conjectures vs. prototyping a modeling framework",
                      "lineHeight": 1.3,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "K7D38",
                      "name": "lesson1body",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Proving is binary; architecting a framework involves taste and many AI sessions.",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "S63bA",
                      "name": "lesson2head",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "From idea to prototype is now feasible, but from prototype to publication remains open",
                      "lineHeight": 1.3,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "LiGWr",
                      "name": "lesson2body",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "AI accelerates idea-to-prototype, but writing and positioning a paper for publication remains a human bottleneck.",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "pILtY",
                      "name": "lesson3head",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Reviewers remain a rare resource",
                      "lineHeight": 1.3,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "xQgvW",
                      "name": "lesson3body",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Prover-verified results still need human reviewers; unfamiliarity with formal methods limits the reviewer pool.",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "BMBFf",
                      "name": "lesson4head",
                      "fill": "#0E2747",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Audit agents outperform builder agents at catching issues",
                      "lineHeight": 1.3,
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "ayWOd",
                      "name": "lesson4body",
                      "fill": "#5B6680",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "AI is stronger at reviewing and finding flaws than at generating correct artifacts from scratch. Always pair a builder agent with an independent audit agent for best results.",
                      "lineHeight": 1.35,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
